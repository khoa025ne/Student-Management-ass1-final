@model StudentManagement.BLL.Services.DTOs.UserDTO

@{
    ViewData["Title"] = "Dashboard Giáo Viên";
}

<div style="margin-top: 2rem;">
    <!-- Welcome Card -->
    <div class="card" style="background: linear-gradient(135deg, #e74c3c, #c0392b); 
                              color: white; margin-bottom: 2rem;">
        <div class="card-body" style="padding: 2rem;">
            <h2 style="margin: 0; margin-bottom: 0.5rem;">
                <i class="bi bi-easel"></i>
                Chào mừng, @Model.Name!
            </h2>
            <p style="margin: 0; opacity: 0.9;">Bạn đang ở vị trí Giáo viên - Quản lý lớp học và nhập điểm</p>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="row three-col">
        <div class="card">
            <div style="display: flex; align-items: center; gap: 1rem;">
                <div style="font-size: 2.5rem; color: var(--primary-color);">
                    <i class="bi bi-building"></i>
                </div>
                <div>
                    <p style="color: var(--text-light); margin: 0; font-size: 0.9rem;">Lớp của tôi</p>
                    <h3 style="margin: 0; color: var(--text-dark);">--</h3>
                </div>
            </div>
        </div>

        <div class="card">
            <div style="display: flex; align-items: center; gap: 1rem;">
                <div style="font-size: 2.5rem; color: var(--info);">
                    <i class="bi bi-people"></i>
                </div>
                <div>
                    <p style="color: var(--text-light); margin: 0; font-size: 0.9rem;">Tổng sinh viên</p>
                    <h3 style="margin: 0; color: var(--text-dark);">--</h3>
                </div>
            </div>
        </div>

        <div class="card">
            <div style="display: flex; align-items: center; gap: 1rem;">
                <div style="font-size: 2.5rem; color: var(--success);">
                    <i class="bi bi-check2-all"></i>
                </div>
                <div>
                    <p style="color: var(--text-light); margin: 0; font-size: 0.9rem;">Đã nhập điểm</p>
                    <h3 style="margin: 0; color: var(--text-dark);">-- %</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="card" style="margin-top: 2rem;">
        <div class="card-header">
            <i class="bi bi-lightning-fill"></i>
            Công cụ giảng dạy
        </div>
        <div class="card-body">
            <div class="row three-col" style="gap: 1rem;">
                <a href="#" class="btn btn-primary" style="text-align: center;">
                    <i class="bi bi-building"></i> Xem Lớp Học
                </a>
                <a href="#" class="btn btn-primary" style="text-align: center;">
                    <i class="bi bi-pencil"></i> Nhập Điểm
                </a>
                <a href="#" class="btn btn-primary" style="text-align: center;">
                    <i class="bi bi-people"></i> Danh Sách Sinh Viên
                </a>
            </div>
        </div>
    </div>
</div>
