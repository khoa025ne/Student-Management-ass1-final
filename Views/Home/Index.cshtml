@{
    ViewData["Title"] = "Trang chủ - Hệ thống quản lý sinh viên";
}

<!-- ===== HERO BANNER (Multi-Layer Parallax Animation) ===== -->
<div class="hero-banner" style="margin: 0 -2rem; margin-top: -100px;">
    <!-- Lớp 1: Background Gradient -->
    <div class="hero-background"></div>

    <!-- Lớp 2: Floating Elements (Parallax) -->
    <div class="hero-floating" style="top: 50px; left: 10%;">
        <div class="float-circle"></div>
    </div>
    <div class="hero-floating" style="bottom: 100px; right: 10%; animation-delay: 1s;">
        <div class="float-circle" style="width: 150px; height: 150px;"></div>
    </div>
    <div class="hero-floating" style="top: 30%; left: 50%; opacity: 0.08;">
        <div class="float-triangle"></div>
    </div>

    <!-- Lớp 3: Content (Text + Buttons) -->
    <div class="hero-content">
        <!-- Tiêu đề chính với animation -->
        <h1 class="hero-title">
            <i class="bi bi-mortarboard" style="margin-right: 1rem; color: var(--accent-color);"></i>
            Hệ Thống Quản Lý Sinh Viên
        </h1>
        
        <!-- Subtitle -->
        <p class="hero-subtitle">
            Quản lý khóa học, điểm số và hồ sơ học tập một cách hiệu quả và chuyên nghiệp
        </p>
        
        <!-- CTA Buttons -->
        <div class="hero-cta">
            @if (string.IsNullOrEmpty(HttpContext.Session.GetString("UserId")))
            {
                <a href="/Auth/Login" class="btn btn-primary" style="padding: 0.9rem 2rem; font-size: 1rem;">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span style="margin-left: 0.5rem;">Đăng nhập</span>
                </a>
                <a href="/Auth/Register" class="btn btn-secondary" style="padding: 0.9rem 2rem; font-size: 1rem;">
                    <i class="bi bi-person-plus"></i>
                    <span style="margin-left: 0.5rem;">Đăng ký ngay</span>
                </a>
            }
            else
            {
                <a href="/Home/StudentDashboard" class="btn btn-primary" style="padding: 0.9rem 2rem; font-size: 1rem;">
                    <i class="bi bi-speedometer2"></i>
                    <span style="margin-left: 0.5rem;">Vào Dashboard</span>
                </a>
                <a href="/Account/Profile" class="btn btn-secondary" style="padding: 0.9rem 2rem; font-size: 1rem;">
                    <i class="bi bi-person"></i>
                    <span style="margin-left: 0.5rem;">Hồ sơ cá nhân</span>
                </a>
            }
        </div>
    </div>
</div>

<!-- ===== FEATURES SECTION ===== -->
<section id="features" style="margin-top: 4rem; padding: 3rem; background: white; border-radius: var(--border-radius-lg); box-shadow: var(--shadow-soft);">
    <h2 style="text-align: center; font-size: 2.5rem; font-weight: 700; margin-bottom: 3rem; color: var(--primary-color);">
        <i class="bi bi-star-fill" style="color: var(--accent-color); margin-right: 0.5rem;"></i>
        Tính Năng Chính
    </h2>

    <div class="row three-col">
        <!-- Feature 1: Quản lý môn học -->
        <div class="card" style="text-align: center; position: relative; overflow: hidden;">
            <div style="font-size: 3rem; margin-bottom: 1rem; color: var(--primary-color);">
                <i class="bi bi-book"></i>
            </div>
            <h3 style="margin-bottom: 0.5rem; color: var(--text-dark);">Quản Lý Môn Học</h3>
            <p style="color: var(--text-light); line-height: 1.8;">
                Dễ dàng đăng ký, quản lý lịch học và theo dõi tiến độ học tập của bạn
            </p>
            <ul style="text-align: left; color: var(--text-light); margin-top: 1rem; font-size: 0.9rem;">
                <li><i class="bi bi-check-circle" style="color: var(--success); margin-right: 0.5rem;"></i>Xem danh sách môn học</li>
                <li><i class="bi bi-check-circle" style="color: var(--success); margin-right: 0.5rem;"></i>Đăng ký lớp học</li>
                <li><i class="bi bi-check-circle" style="color: var(--success); margin-right: 0.5rem;"></i>Kiểm tra tiên quyết</li>
            </ul>
        </div>

        <!-- Feature 2: Quản lý điểm số -->
        <div class="card" style="text-align: center;">
            <div style="font-size: 3rem; margin-bottom: 1rem; color: var(--accent-color);">
                <i class="bi bi-graph-up"></i>
            </div>
            <h3 style="margin-bottom: 0.5rem; color: var(--text-dark);">Quản Lý Điểm Số</h3>
            <p style="color: var(--text-light); line-height: 1.8;">
                Xem điểm số chi tiết, GPA và nhận phản hồi từ AI về hiệu suất học tập
            </p>
            <ul style="text-align: left; color: var(--text-light); margin-top: 1rem; font-size: 0.9rem;">
                <li><i class="bi bi-check-circle" style="color: var(--success); margin-right: 0.5rem;"></i>Bảng điểm từng môn</li>
                <li><i class="bi bi-check-circle" style="color: var(--success); margin-right: 0.5rem;"></i>Tính GPA tự động</li>
                <li><i class="bi bi-check-circle" style="color: var(--success); margin-right: 0.5rem;"></i>Phúc khảo điểm</li>
            </ul>
        </div>

        <!-- Feature 3: Ví điện tử -->
        <div class="card" style="text-align: center;">
            <div style="font-size: 3rem; margin-bottom: 1rem; color: var(--info);">
                <i class="bi bi-wallet2"></i>
            </div>
            <h3 style="margin-bottom: 0.5rem; color: var(--text-dark);">Ví Điện Tử</h3>
            <p style="color: var(--text-light); line-height: 1.8;">
                Quản lý tài chính học tập, nạp tiền và theo dõi các giao dịch một cách dễ dàng
            </p>
            <ul style="text-align: left; color: var(--text-light); margin-top: 1rem; font-size: 0.9rem;">
                <li><i class="bi bi-check-circle" style="color: var(--success); margin-right: 0.5rem;"></i>Nạp tiền linh hoạt</li>
                <li><i class="bi bi-check-circle" style="color: var(--success); margin-right: 0.5rem;"></i>Lịch sử giao dịch</li>
                <li><i class="bi bi-check-circle" style="color: var(--success); margin-right: 0.5rem;"></i>Thanh toán học phí</li>
            </ul>
        </div>

        <!-- Feature 4: Thời khóa biểu -->
        <div class="card" style="text-align: center;">
            <div style="font-size: 3rem; margin-bottom: 1rem; color: var(--warning);">
                <i class="bi bi-calendar-week"></i>
            </div>
            <h3 style="margin-bottom: 0.5rem; color: var(--text-dark);">Thời Khóa Biểu</h3>
            <p style="color: var(--text-light); line-height: 1.8;">
                Xem lịch học chi tiết, phòng học, giảng viên và thời gian lên lớp
            </p>
            <ul style="text-align: left; color: var(--text-light); margin-top: 1rem; font-size: 0.9rem;">
                <li><i class="bi bi-check-circle" style="color: var(--success); margin-right: 0.5rem;"></i>Lịch học theo tuần</li>
                <li><i class="bi bi-check-circle" style="color: var(--success); margin-right: 0.5rem;"></i>Thông tin phòng học</li>
                <li><i class="bi bi-check-circle" style="color: var(--success); margin-right: 0.5rem;"></i>Kiểm tra trùng lịch</li>
            </ul>
        </div>

        <!-- Feature 5: Phân tích AI -->
        <div class="card" style="text-align: center;">
            <div style="font-size: 3rem; margin-bottom: 1rem; color: var(--accent-color);">
                <i class="bi bi-robot"></i>
            </div>
            <h3 style="margin-bottom: 0.5rem; color: var(--text-dark);">Phân Tích AI</h3>
            <p style="color: var(--text-light); line-height: 1.8;">
                Nhận được gợi ý cải thiện từ AI dựa trên hiệu suất học tập của bạn
            </p>
            <ul style="text-align: left; color: var(--text-light); margin-top: 1rem; font-size: 0.9rem;">
                <li><i class="bi bi-check-circle" style="color: var(--success); margin-right: 0.5rem;"></i>Phân tích hiệu suất</li>
                <li><i class="bi bi-check-circle" style="color: var(--success); margin-right: 0.5rem;"></i>Gợi ý cải thiện</li>
                <li><i class="bi bi-check-circle" style="color: var(--success); margin-right: 0.5rem;"></i>Nhật ký học tập</li>
            </ul>
        </div>

        <!-- Feature 6: Hồ sơ cá nhân -->
        <div class="card" style="text-align: center;">
            <div style="font-size: 3rem; margin-bottom: 1rem; color: var(--info);">
                <i class="bi bi-person-badge"></i>
            </div>
            <h3 style="margin-bottom: 0.5rem; color: var(--text-dark);">Hồ Sơ Cá Nhân</h3>
            <p style="color: var(--text-light); line-height: 1.8;">
                Quản lý thông tin cá nhân, cập nhật hình đại diện và thay đổi mật khẩu
            </p>
            <ul style="text-align: left; color: var(--text-light); margin-top: 1rem; font-size: 0.9rem;">
                <li><i class="bi bi-check-circle" style="color: var(--success); margin-right: 0.5rem;"></i>Chỉnh sửa thông tin</li>
                <li><i class="bi bi-check-circle" style="color: var(--success); margin-right: 0.5rem;"></i>Bảo mật tài khoản</li>
                <li><i class="bi bi-check-circle" style="color: var(--success); margin-right: 0.5rem;"></i>Lịch sử hoạt động</li>
            </ul>
        </div>
    </div>
</section>

<!-- ===== CTA SECTION ===== -->
<section style="margin-top: 4rem; padding: 3rem; background: linear-gradient(135deg, var(--primary-color), var(--primary-dark)); border-radius: var(--border-radius-lg); color: white; text-align: center;">
    <h2 style="font-size: 2rem; margin-bottom: 1rem;">
        Sẵn sàng bắt đầu?
    </h2>
    <p style="font-size: 1.1rem; margin-bottom: 2rem; opacity: 0.9;">
        Tham gia cộng đồng sinh viên FPT ngay hôm nay và quản lý quá trình học tập của bạn một cách thông minh
    </p>
    
    @if (string.IsNullOrEmpty(HttpContext.Session.GetString("UserId")))
    {
        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
            <a href="/Auth/Register" class="btn btn-accent" style="padding: 0.9rem 2rem; font-size: 1rem;">
                <i class="bi bi-person-plus"></i>
                <span style="margin-left: 0.5rem;">Đăng Ký Miễn Phí</span>
            </a>
            <a href="/Auth/Login" class="btn btn-secondary" style="padding: 0.9rem 2rem; font-size: 1rem; border-color: white; color: white;">
                <i class="bi bi-box-arrow-in-right"></i>
                <span style="margin-left: 0.5rem;">Đăng Nhập</span>
            </a>
        </div>
    }
</section>

<!-- ===== STATISTICS SECTION ===== -->
<section style="margin-top: 4rem; padding: 3rem; background: white; border-radius: var(--border-radius-lg); box-shadow: var(--shadow-soft);">
    <h2 style="text-align: center; font-size: 2rem; font-weight: 700; margin-bottom: 3rem; color: var(--primary-color);">
        Thống Kê Hệ Thống
    </h2>

    <div class="row three-col" style="grid-template-columns: repeat(4, 1fr);">
        <div style="text-align: center; padding: 1.5rem;">
            <div style="font-size: 2.5rem; font-weight: 700; color: var(--primary-color); margin-bottom: 0.5rem;">
                2500+
            </div>
            <p style="color: var(--text-light); font-size: 0.95rem;">Sinh viên</p>
        </div>
        <div style="text-align: center; padding: 1.5rem;">
            <div style="font-size: 2.5rem; font-weight: 700; color: var(--accent-color); margin-bottom: 0.5rem;">
                150+
            </div>
            <p style="color: var(--text-light); font-size: 0.95rem;">Môn học</p>
        </div>
        <div style="text-align: center; padding: 1.5rem;">
            <div style="font-size: 2.5rem; font-weight: 700; color: var(--info); margin-bottom: 0.5rem;">
                98%
            </div>
            <p style="color: var(--text-light); font-size: 0.95rem;">Hài lòng</p>
        </div>
        <div style="text-align: center; padding: 1.5rem;">
            <div style="font-size: 2.5rem; font-weight: 700; color: var(--success); margin-bottom: 0.5rem;">
                24/7
            </div>
            <p style="color: var(--text-light); font-size: 0.95rem;">Hỗ trợ</p>
        </div>
    </div>
</section>
