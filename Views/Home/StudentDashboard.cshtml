@model StudentManagement.BLL.Services.DTOs.UserDTO

@{
    ViewData["Title"] = "Dashboard Sinh Viên";
}

<div style="margin-top: 2rem;">
    <!-- Welcome Card -->
    <div class="card" style="background: linear-gradient(135deg, var(--info), #2980b9); 
                              color: white; margin-bottom: 2rem;">
        <div style="padding: 2rem;">
            <h2 style="margin: 0; margin-bottom: 0.5rem;">
                <i class="bi bi-mortarboard"></i>
                Xin chào, @Model.Name!
            </h2>
            <p style="margin: 0; opacity: 0.9;">
                Mã sinh viên: <strong>@(Model.RollNumber ?? "Chưa cập nhật")</strong> | 
                Lớp: <strong>@(Model.ClassCode ?? "Chưa cập nhật")</strong>
            </p>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="row three-col">
        <div class="card">
            <div style="display: flex; align-items: center; gap: 1rem;">
                <div style="font-size: 2.5rem; color: var(--accent-color);">
                    <i class="bi bi-wallet2"></i>
                </div>
                <div>
                    <p style="color: var(--text-light); margin: 0; font-size: 0.9rem;">Ví điện tử</p>
                    <h3 style="margin: 0; color: var(--text-dark);">@Model.WalletBalance.ToString("N0") đ</h3>
                </div>
            </div>
        </div>

        <div class="card">
            <div style="display: flex; align-items: center; gap: 1rem;">
                <div style="font-size: 2.5rem; color: var(--success);">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div>
                    <p style="color: var(--text-light); margin: 0; font-size: 0.9rem;">Môn học đã đăng ký</p>
                    <h3 style="margin: 0; color: var(--text-dark);">--</h3>
                </div>
            </div>
        </div>

        <div class="card">
            <div style="display: flex; align-items: center; gap: 1rem;">
                <div style="font-size: 2.5rem; color: var(--primary-color);">
                    <i class="bi bi-graph-up"></i>
                </div>
                <div>
                    <p style="color: var(--text-light); margin: 0; font-size: 0.9rem;">GPA hiện tại</p>
                    <h3 style="margin: 0; color: var(--text-dark);">--</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="card" style="margin-top: 2rem;">
        <div class="card-header">
            <i class="bi bi-lightning-fill"></i>
            Hành động nhanh
        </div>
        <div style="padding: 1.5rem;">
            <div class="row three-col" style="gap: 1rem;">
                <a href="#" class="btn btn-primary" style="text-align: center;">
                    <i class="bi bi-plus-circle"></i> Đăng Ký Môn Học
                </a>
                <a href="#" class="btn btn-primary" style="text-align: center;">
                    <i class="bi bi-calendar"></i> Xem Lịch Học
                </a>
                <a href="#" class="btn btn-primary" style="text-align: center;">
                    <i class="bi bi-file-earmark"></i> Xem Điểm Số
                </a>
            </div>
        </div>
    </div>
</div>
