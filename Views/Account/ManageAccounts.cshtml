@model List<StudentManagement.BLL.Services.DTOs.UserDTO>

@{
    ViewData["Title"] = "Quản lý tài khoản";
}

<div style="margin-top: 2rem;">
    <div class="card">
        <div class="card-header">
            <i class="bi bi-people"></i>
            Quản lý tài khoản
        </div>

        <div style="padding: 1.5rem;">
            <a href="/Account/CreateAccount" class="btn btn-primary" style="margin-bottom: 1.5rem;">
                <i class="bi bi-person-plus"></i>
                Tạo tài khoản mới
            </a>

            <table class="table">
                <thead>
                    <tr>
                        <th>Tên</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Mã SV</th>
                        <th>Lớp</th>
                        <th>Trạng thái</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                <strong>@user.Name</strong>
                            </td>
                            <td>@user.Email</td>
                            <td>
                                <span class="badge" style="background: @(user.RoleName == "Admin" ? "rgba(30, 58, 95, 0.1)" : "rgba(52, 152, 219, 0.1)");
                                                          color: @(user.RoleName == "Admin" ? "var(--primary-color)" : "var(--info)");">
                                    @user.RoleName
                                </span>
                            </td>
                            <td>@(user.RollNumber ?? "-")</td>
                            <td>@(user.ClassCode ?? "-")</td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge badge-success">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">Khóa</span>
                                }
                            </td>
                            <td>
                                <div style="display: flex; gap: 0.5rem;">
                                    @if (user.IsActive && user.RoleName != "Admin")
                                    {
                                        <form method="post" asp-action="ToggleUserStatus" style="display: inline;">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit" class="btn btn-sm btn-warning" 
                                                    onclick="return confirm('Khóa tài khoản này?')">
                                                <i class="bi bi-lock"></i>
                                            </button>
                                        </form>
                                    }
                                    else if (!user.IsActive && user.RoleName != "Admin")
                                    {
                                        <form method="post" asp-action="ToggleUserStatus" style="display: inline;">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="bi bi-unlock"></i>
                                            </button>
                                        </form>
                                    }

                                    @if (user.RoleName != "Admin")
                                    {
                                        <form method="post" asp-action="DeleteUser" style="display: inline;">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit" class="btn btn-sm btn-danger" 
                                                    onclick="return confirm('Xóa tài khoản này?')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function viewUser(userId) {
            // Có thể mở modal chi tiết user hoặc redirect đến trang detail
            alert('Xem chi tiết user: ' + userId);
        }
    </script>
}
