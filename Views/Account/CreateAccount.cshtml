@model StudentManagement.BLL.Services.DTOs.CreateAccountDTO

@{
    ViewData["Title"] = "Tạo tài khoản";
}

<div class="row two-col" style="margin-top: 2rem;">
    <div class="card">
        <div class="card-header">
            <i class="bi bi-person-badge"></i>
            Tạo tài khoản mới
        </div>

        <form method="post" asp-action="CreateAccount" style="padding: 1.5rem;">
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Count > 0)
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-circle"></i>
                    @Html.ValidationSummary()
                </div>
            }

            <div class="form-group">
                <label class="form-label">Họ và tên</label>
                <input type="text" class="form-input" name="Name" placeholder="Nhập họ tên" required asp-for="Name" />
            </div>

            <div class="form-group">
                <label class="form-label">Email</label>
                <input type="email" class="form-input" name="Email" placeholder="user@example.com" required asp-for="Email" />
            </div>

            <div class="form-group">
                <label class="form-label">Số điện thoại</label>
                <input type="tel" class="form-input" name="Phone" placeholder="0912345678" asp-for="Phone" />
            </div>

            <div class="form-group">
                <label class="form-label">Role</label>
                <select class="form-select" name="RoleId" required asp-for="RoleId" onchange="toggleBatchField()">
                    <option value="">-- Chọn role --</option>
                    <option value="2">Manager (Quản lý)</option>
                    <option value="3">Student (Sinh viên)</option>
                    <option value="4">Teacher (Giáo viên)</option>
                </select>
            </div>

            <div class="form-group" id="batchField" style="display: none;">
                <label class="form-label">Niên khóa (chỉ cho sinh viên)</label>
                <input type="number" class="form-input" name="Batch" placeholder="2024" min="2020" asp-for="Batch" />
            </div>

            <div class="form-group">
                <label class="form-label">Giới tính</label>
                <select class="form-select" name="Gender" asp-for="Gender">
                    <option value="">-- Chọn --</option>
                    <option value="Nam">Nam</option>
                    <option value="Nữ">Nữ</option>
                    <option value="Khác">Khác</option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Ngày sinh</label>
                <input type="date" class="form-input" name="DateOfBirth" asp-for="DateOfBirth" />
            </div>

            <div class="form-group">
                <label class="form-label">Mật khẩu</label>
                <input type="password" class="form-input" name="Password" placeholder="Nhập mật khẩu" required asp-for="Password" />
            </div>

            <div class="form-group">
                <label class="form-label">Xác nhận mật khẩu</label>
                <input type="password" class="form-input" name="ConfirmPassword" placeholder="Nhập lại mật khẩu" required />
            </div>

            <div style="display: flex; gap: 1rem; margin-top: 2rem;">
                <a href="/Account/ManageAccounts" class="btn btn-secondary" style="flex: 1; text-align: center;">Hủy</a>
                <button type="submit" class="btn btn-primary" style="flex: 1;">
                    <i class="bi bi-plus-circle"></i>
                    Tạo tài khoản
                </button>
            </div>
        </form>
    </div>

    <div class="card">
        <div class="card-header">
            <i class="bi bi-info-circle"></i>
            Hướng dẫn
        </div>
        <div style="padding: 1.5rem;">
            <h4 style="margin-bottom: 1rem;">Thông tin về các role:</h4>
            
            <div style="margin-bottom: 1.5rem;">
                <strong style="color: var(--primary-color);">👤 Manager</strong>
                <p style="color: var(--text-light); font-size: 0.9rem;">
                    Quản lý tài chính & nhân sự, xem báo cáo, quản lý điểm số
                </p>
            </div>

            <div style="margin-bottom: 1.5rem;">
                <strong style="color: var(--info);">🎓 Student</strong>
                <p style="color: var(--text-light); font-size: 0.9rem;">
                    Đăng ký môn học, xem lịch học, kiểm tra điểm số, quản lý ví điện tử
                </p>
            </div>

            <div>
                <strong style="color: var(--success);">👨‍🏫 Teacher</strong>
                <p style="color: var(--text-light); font-size: 0.9rem;">
                    Quản lý lớp học, nhập điểm, tương tác với sinh viên
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleBatchField() {
            const roleId = document.querySelector('select[name="RoleId"]').value;
            const batchField = document.getElementById('batchField');
            
            if (roleId === '3') { // Student
                batchField.style.display = 'block';
            } else {
                batchField.style.display = 'none';
            }
        }
    </script>
}
