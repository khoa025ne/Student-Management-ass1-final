@model StudentManagement.BLL.Services.DTOs.RegisterDTO

@{
    ViewData["Title"] = "Đăng Ký";
}

<div class="row two-col" style="margin-top: 2rem; max-width: 1000px; margin-left: auto; margin-right: auto;">
    <!-- ===== HERO SECTION (Bên Trái) ===== -->
    <div style="background: linear-gradient(135deg, var(--accent-color) 0%, #e67e34 100%);
                border-radius: var(--border-radius-lg); padding: 3rem; 
                display: flex; flex-direction: column; justify-content: center; 
                align-items: center; text-align: center; min-height: 450px; color: white; position: relative; overflow: hidden;">
        
        <!-- Floating Background Elements -->
        <div style="position: absolute; width: 300px; height: 300px; border-radius: 50%; 
                    background: rgba(255, 255, 255, 0.05); top: -100px; right: -100px; 
                    animation: float 6s ease-in-out infinite;"></div>
        <div style="position: absolute; width: 200px; height: 200px; border-radius: 50%; 
                    background: rgba(30, 58, 95, 0.1); bottom: -50px; left: -50px; 
                    animation: float 8s ease-in-out infinite; animation-delay: 1s;"></div>

        <!-- Content -->
        <div style="position: relative; z-index: 10;">
            <div style="font-size: 4rem; margin-bottom: 1.5rem; color: white;">
                <i class="bi bi-person-plus"></i>
            </div>
            <h1 style="font-size: 2.5rem; font-weight: 700; margin-bottom: 1rem;">
                Gia Nhập Cộng Đồng
            </h1>
            <p style="font-size: 1.1rem; margin-bottom: 2rem; opacity: 0.95; line-height: 1.8;">
                Tạo tài khoản miễn phí để bắt đầu hành trình học tập của bạn
            </p>
            <p style="font-size: 0.9rem; opacity: 0.8;">
                <i class="bi bi-star-fill" style="margin-right: 0.5rem;"></i>
                Truy cập toàn bộ tính năng nhanh chóng
            </p>
        </div>
    </div>

    <!-- ===== FORM SECTION (Bên Phải) ===== -->
    <div class="card">
        <div class="card-header">
            <i class="bi bi-person-check" style="margin-right: 0.5rem;"></i>
            Tạo Tài Khoản Mới
        </div>

        <form method="post" asp-action="Register" asp-controller="Auth" style="padding: 1.5rem;">
            
            <!-- Validation Summary -->
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Count > 0)
            {
                <div class="alert alert-danger" role="alert" style="margin-bottom: 1.5rem;">
                    <i class="bi bi-exclamation-circle"></i>
                    <strong style="margin-left: 0.5rem;">Kiểm tra lại thông tin:</strong>
                    @Html.ValidationSummary(false)
                </div>
            }

            <!-- Full Name Field -->
            <div class="form-group">
                <label class="form-label" for="Name">
                    <i class="bi bi-person" style="color: var(--primary-color); margin-right: 0.5rem;"></i>
                    Họ và Tên
                </label>
                <input type="text" 
                       class="form-input" 
                       id="Name"
                       name="Name" 
                       placeholder="Nguyễn Văn A" 
                       required 
                       asp-for="Name" />
                <span class="form-error">@Html.ValidationMessageFor(m => m.Name)</span>
            </div>

            <!-- Email Field -->
            <div class="form-group">
                <label class="form-label" for="Email">
                    <i class="bi bi-envelope-at" style="color: var(--primary-color); margin-right: 0.5rem;"></i>
                    Địa chỉ Email
                </label>
                <input type="email" 
                       class="form-input" 
                       id="Email"
                       name="Email" 
                       placeholder="you@example.com" 
                       required 
                       asp-for="Email" />
                <span class="form-error">@Html.ValidationMessageFor(m => m.Email)</span>
            </div>

            <!-- Phone Field -->
            <div class="form-group">
                <label class="form-label" for="Phone">
                    <i class="bi bi-telephone" style="color: var(--primary-color); margin-right: 0.5rem;"></i>
                    Số Điện Thoại
                </label>
                <input type="tel" 
                       class="form-input" 
                       id="Phone"
                       name="Phone" 
                       placeholder="0912345678" 
                       asp-for="Phone" />
                <span class="form-error">@Html.ValidationMessageFor(m => m.Phone)</span>
            </div>

            <!-- Date of Birth Field -->
            <div class="form-group">
                <label class="form-label" for="DateOfBirth">
                    <i class="bi bi-calendar" style="color: var(--primary-color); margin-right: 0.5rem;"></i>
                    Ngày Sinh
                </label>
                <input type="date" 
                       class="form-input" 
                       id="DateOfBirth"
                       asp-for="DateOfBirth" />
                <span class="form-error">@Html.ValidationMessageFor(m => m.DateOfBirth)</span>
            </div>

            <!-- Gender Field -->
            <div class="form-group">
                <label class="form-label" for="Gender">
                    <i class="bi bi-person-lines-fill" style="color: var(--primary-color); margin-right: 0.5rem;"></i>
                    Giới Tính
                </label>
                <select class="form-select" id="Gender" asp-for="Gender">
                    <option value="">-- Chọn giới tính --</option>
                    <option value="Nam">Nam</option>
                    <option value="Nữ">Nữ</option>
                    <option value="Khác">Khác</option>
                </select>
                <span class="form-error">@Html.ValidationMessageFor(m => m.Gender)</span>
            </div>

            <!-- Password Field -->
            <div class="form-group">
                <label class="form-label" for="Password">
                    <i class="bi bi-lock" style="color: var(--primary-color); margin-right: 0.5rem;"></i>
                    Mật Khẩu
                </label>
                <input type="password" 
                       class="form-input" 
                       id="Password"
                       name="Password" 
                       placeholder="••••••••" 
                       required 
                       asp-for="Password" />
                <span class="form-error">@Html.ValidationMessageFor(m => m.Password)</span>
                <small style="color: var(--text-light); font-size: 0.8rem; margin-top: 0.25rem; display: block;">
                    <i class="bi bi-info-circle"></i> Mật khẩu phải dài ít nhất 6 ký tự
                </small>
            </div>

            <!-- Confirm Password Field -->
            <div class="form-group">
                <label class="form-label" for="ConfirmPassword">
                    <i class="bi bi-lock-check" style="color: var(--primary-color); margin-right: 0.5rem;"></i>
                    Xác Nhận Mật Khẩu
                </label>
                <input type="password" 
                       class="form-input" 
                       id="ConfirmPassword"
                       name="ConfirmPassword" 
                       placeholder="••••••••" 
                       required 
                       asp-for="ConfirmPassword" />
                <span class="form-error">@Html.ValidationMessageFor(m => m.ConfirmPassword)</span>
            </div>

            <!-- Terms & Conditions -->
            <div class="form-group" style="flex-direction: row; align-items: flex-start; margin-bottom: 2rem;">
                <input type="checkbox" id="Terms" name="Terms" style="cursor: pointer; margin-right: 0.5rem; margin-top: 0.2rem;" required />
                <label for="Terms" style="margin: 0; cursor: pointer; font-size: 0.9rem;">
                    Tôi đồng ý với <a href="#" style="color: var(--primary-color); text-decoration: none;">Điều khoản sử dụng</a> và <a href="#" style="color: var(--primary-color); text-decoration: none;">Chính sách bảo mật</a>
                </label>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.9rem; font-size: 1rem; font-weight: 600;">
                <i class="bi bi-person-plus"></i>
                <span style="margin-left: 0.5rem;">Đăng Ký</span>
            </button>

            <!-- Divider -->
            <div style="margin: 1.5rem 0; text-align: center; color: var(--text-light);">
                <span style="font-size: 0.85rem;">hoặc</span>
            </div>

            <!-- Link to Login -->
            <a href="/Auth/Login" class="btn btn-secondary" style="width: 100%; text-align: center;">
                <i class="bi bi-box-arrow-in-right"></i>
                <span style="margin-left: 0.5rem;">Bạn đã có tài khoản? Đăng nhập</span>
            </a>
        </form>
    </div>
</div>

<!-- ===== INFO SECTION (Dưới form) ===== -->
<section style="margin-top: 3rem; padding: 2rem; background: white; border-radius: var(--border-radius-lg); box-shadow: var(--shadow-soft);">
    <h3 style="text-align: center; font-size: 1.5rem; font-weight: 700; margin-bottom: 2rem; color: var(--primary-color);">
        <i class="bi bi-lightbulb-fill" style="color: var(--accent-color); margin-right: 0.5rem;"></i>
        Lợi Ích Của Việc Đăng Ký
    </h3>
    
    <div class="row three-col">
        <div style="text-align: center;">
            <div style="font-size: 2.5rem; color: var(--success); margin-bottom: 1rem;">
                <i class="bi bi-check-circle"></i>
            </div>
            <h4 style="margin-bottom: 0.5rem; color: var(--text-dark);">Miễn Phí</h4>
            <p style="color: var(--text-light); font-size: 0.9rem;">
                Không phí đăng ký, hoàn toàn miễn phí
            </p>
        </div>
        <div style="text-align: center;">
            <div style="font-size: 2.5rem; color: var(--info); margin-bottom: 1rem;">
                <i class="bi bi-speedometer2"></i>
            </div>
            <h4 style="margin-bottom: 0.5rem; color: var(--text-dark);">Nhanh Gọn</h4>
            <p style="color: var(--text-light); font-size: 0.9rem;">
                Đăng ký trong 1 phút, truy cập ngay
            </p>
        </div>
        <div style="text-align: center;">
            <div style="font-size: 2.5rem; color: var(--accent-color); margin-bottom: 1rem;">
                <i class="bi bi-shield-lock"></i>
            </div>
            <h4 style="margin-bottom: 0.5rem; color: var(--text-dark);">Bảo Mật</h4>
            <p style="color: var(--text-light); font-size: 0.9rem;">
                Thông tin được bảo vệ tuyệt đối
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    
    <script>
        // Password match validation
        document.getElementById('ConfirmPassword').addEventListener('change', function() {
            if (this.value !== document.getElementById('Password').value) {
                this.classList.add('is-invalid');
            } else {
                this.classList.remove('is-invalid');
            }
        });
    </script>
}
